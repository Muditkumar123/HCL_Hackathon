# Copy to .env (never commit .env). Ollama runs on GPU 1 on port 11435 with the model kept loaded.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11435
MOCK_LLM=false
DB_PATH=data/app.db
# ISO date (YYYY-MM-DD). Empty => earliest plants.week, else Monday two weeks before the earliest due date.
PLANNING_START=
# Used by the Streamlit UI
API_URL=http://localhost:8000
